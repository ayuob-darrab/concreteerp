APP_NAME=ConcreteERP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# محلياً: يمكن فتح المشروع من جهاز آخر على الشبكة عبر http://YOUR_LAN_IP/ConcreteERP (مع Laragon وجدار الحماية). في local يُحدَّث جذر الروابط تلقائياً عند استخدام IP.
APP_URL=http://localhost/ConcreteERP

# أداء (خطة-تطوير): عند true يُرمى استثناء عند lazy-load لعلاقة غير محمّلة مسبقاً (غير الإنتاج فقط)
PERFORMANCE_DETECT_N1=false

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=concreteerp
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# CDN (خطة-تطوير): اتركه فارغاً محلياً؛ على الإنتاج ضع رابط CDN إن وُجد
ASSET_URL=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# عند تفعيل Redis في Laragon يمكنك استخدام: CACHE_DRIVER=redis و SESSION_DRIVER=redis
# Laravel يستخدم predis أو phpredis حسب التوفر

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
